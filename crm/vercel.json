{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": "core.py" }
    },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py?__p=$1" },
    { "src": "/favicon.ico", "dest": "/assets/logo.png" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/([^/.]+)/?$", "dest": "/$1.html" }
  ]
}
